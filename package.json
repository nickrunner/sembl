{
  "name": "sembl",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "pnpm -r exec tsc --noEmit",
    "version:set": "node scripts/set-version.mjs",
    "check:exports": "pnpm -r --filter './packages/*' --filter '!@sembl/examples' exec attw --pack . --format ascii"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
