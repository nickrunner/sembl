{
  "name": "@sembl/examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run extract && tsup",
    "extract": "node ../compiler/dist/cli/index.js extract --input src/schemas --output src/generated",
    "demo": "node dist/run.js",
    "eval": "node ../compiler/dist/cli/index.js eval --config dist/support/eval-config.js --fixtures evals/listing --mode partialCoerce --replay recordings"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@sembl/compiler": "workspace:*",
    "@sembl/core": "workspace:*",
    "@sembl/provider-anthropic": "workspace:*",
    "@sembl/provider-openai": "workspace:*",
    "@sembl/source-audio": "workspace:*",
    "@sembl/source-email": "workspace:*",
    "@sembl/source-html": "workspace:*",
    "@sembl/source-pdf": "workspace:*",
    "@sembl/source-table": "workspace:*",
    "@sembl/testing": "workspace:*",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
