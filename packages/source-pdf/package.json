{
  "name": "@sembl/source-pdf",
  "version": "0.5.0",
  "description": "Turn a PDF into readable text sources for SEMBL: metadata first, page breaks marked, one source per page when the budget needs it.",
  "keywords": [
    "llm",
    "extraction",
    "pdf",
    "pdfjs",
    "text-extraction"
  ],
  "license": "MIT",
  "author": "Sembl contributors",
  "homepage": "https://github.com/nickrunner/sembl#readme",
  "bugs": {
    "url": "https://github.com/nickrunner/sembl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickrunner/sembl.git",
    "directory": "packages/source-pdf"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@sembl/core": "workspace:*",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
