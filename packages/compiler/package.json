{
  "name": "@sembl/compiler",
  "version": "0.1.0",
  "description": "Schema compiler for SEMBL: extracts runtime schemas from decorated TypeScript classes.",
  "keywords": [
    "llm",
    "structured-output",
    "json-schema",
    "typescript",
    "decorators",
    "ast",
    "compiler"
  ],
  "license": "MIT",
  "author": "Sembl contributors",
  "homepage": "https://github.com/nickrunner/sembl#readme",
  "bugs": {
    "url": "https://github.com/nickrunner/sembl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickrunner/sembl.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sembl": "./dist/cli/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@sembl/core": "workspace:*",
    "commander": "^12.0.0",
    "glob": "^11.0.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
