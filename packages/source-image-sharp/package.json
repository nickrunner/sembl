{
  "name": "@sembl/source-image-sharp",
  "version": "0.5.0",
  "description": "A sharp-backed ImageResizer for @sembl/source-image: downscale to the long edge a model actually reads, auto-orient, strip metadata, and convert HEIC to JPEG where libvips can.",
  "keywords": [
    "llm",
    "extraction",
    "image",
    "sharp",
    "libvips",
    "resize",
    "heic",
    "vision"
  ],
  "license": "MIT",
  "author": "Sembl contributors",
  "homepage": "https://github.com/nickrunner/sembl#readme",
  "bugs": {
    "url": "https://github.com/nickrunner/sembl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickrunner/sembl.git",
    "directory": "packages/source-image-sharp"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@sembl/source-image": "workspace:*",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
