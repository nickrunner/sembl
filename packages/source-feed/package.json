{
  "name": "@sembl/source-feed",
  "version": "0.5.0",
  "description": "Turn XML, RSS/Atom, iCalendar and JSON feeds into readable text sources for SEMBL, one per item for batch coercion.",
  "keywords": [
    "llm",
    "extraction",
    "xml",
    "rss",
    "atom",
    "icalendar",
    "ics",
    "json",
    "feed"
  ],
  "license": "MIT",
  "author": "Sembl contributors",
  "homepage": "https://github.com/nickrunner/sembl#readme",
  "bugs": {
    "url": "https://github.com/nickrunner/sembl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickrunner/sembl.git",
    "directory": "packages/source-feed"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@sembl/core": "workspace:*",
    "@sembl/source-html": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
