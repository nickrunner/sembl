{
  "name": "@sembl/source-docx",
  "version": "0.5.0",
  "description": "Turn a Word document (.docx or .odt) into structured text for SEMBL: headings, lists, tables and footnotes kept, formatting dropped.",
  "keywords": [
    "llm",
    "extraction",
    "docx",
    "odt",
    "word",
    "openxml",
    "opendocument"
  ],
  "license": "MIT",
  "author": "Sembl contributors",
  "homepage": "https://github.com/nickrunner/sembl#readme",
  "bugs": {
    "url": "https://github.com/nickrunner/sembl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickrunner/sembl.git",
    "directory": "packages/source-docx"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@sembl/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "docx": "^9.7.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
